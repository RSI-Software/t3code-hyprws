{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Dev Web",
      "command": "vp run dev:app --preview",
      "icon": "debug"
    },
    {
      "name": "Dev Web (External)",
      "command": "vp run dev:app --external",
      "icon": "debug"
    },
    {
      "name": "Dev Desktop",
      "command": "vp run dev:app --desktop",
      "icon": "debug"
    },
    {
      "name": "Dev Desktop Agent",
      "command": "vp run dev:desktop:agent",
      "icon": "debug"
    },
    {
      "name": "Dev Desktop Agent URL",
      "command": "vp run dev:desktop:agent:url",
      "icon": "debug"
    },
    {
      "name": "Hyprland Workspace",
      "command": "vp run hypr:workspace",
      "icon": "configure"
    }
  ]
}
